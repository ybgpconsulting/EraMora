{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eramora",
	"main": "worker.ts",
	"compatibility_date": "2026-11-19",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "eramora.in", "custom_domain": true },
		{ "pattern": "www.eramora.in", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": true,
		"issues": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
			"persist": true
		}
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eramora-store",
			// Replace this placeholder with the id printed by:
			//   wrangler d1 create eramora-store
			"database_id": "f6ac0e42-2129-40a0-b755-7d142506cf91",
			"migrations_dir": "migrations"
		}
	],
	// Optional: create an R2 bucket and uncomment this binding to store admin
	// image uploads in R2 instead of the built-in D1 media table.
	// "r2_buckets": [{ "binding": "FILES", "bucket_name": "eramora-uploads" }],
	"vars": {
		"ENVIRONMENT": "production"
	},
	"secrets": {
		"required": ["ADMIN_DEMO_PASSWORD", "SESSION_SECRET"]
	}
}