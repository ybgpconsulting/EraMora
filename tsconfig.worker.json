{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["worker.ts", "server/**/*.ts", "src/types/store.ts", "src/utils/commerce.ts"],
  "exclude": ["server/**/*.test.ts", "dist", "node_modules"]
}
