# Local reference for Worker variables and secrets.
# Wrangler reads `.dev.vars` in development — copy `.dev.vars.example`.
# In production use `wrangler secret put <NAME>` or the Sites secrets panel.

# Public canonical origin used in sitemap.xml (optional; defaults to request origin)
APP_URL=""

# Session signing key. Optional: when absent, a 256-bit secret is generated and
# persisted in D1, so sessions survive deploys without extra setup.
SESSION_SECRET=""

# Required for production; use a strong unique password. Local development may
# use the development-only value from .dev.vars.example.
ADMIN_DEMO_PASSWORD=""

