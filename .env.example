# Copy `.dev.vars.example` to `.dev.vars` for local Wrangler development.
# A session secret is required for administrator login in every environment.
# Set a random value of at least 32 characters locally and use a Worker secret
# in production (`wrangler secret put SESSION_SECRET`).
SESSION_SECRET=""

# Set to enable administrator login in any environment (12-256 characters).
ADMIN_DEMO_PASSWORD=""

